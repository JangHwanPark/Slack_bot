# === 슬랙 ===
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# 채널 자동 게시를 켤 때만 필요한 채널 ID (예: C01ABCDE23F)
SLACK_NOTIFY_CHANNEL=

# === 서버 헬스 체크 ===
# /server 커맨드가 호출할 주소. 비워 두면 '주소 미설정'으로 표시된다
# 서버를 추가하려면 src/servers/registry.js 에 이름을 넣고 SERVER_<이름>_URL 을 채운다
SERVER_BETA_URL=
SERVER_BETA2_URL=
SERVER_HOTFIX_URL=
SERVER_CHECK_TIMEOUT_MS=5000

# === 메일 소스 ===
# gmail | fixture  (fixture는 fixtures/mails 의 텍스트 파일을 메일처럼 읽는 로컬 테스트 모드)
MAIL_SOURCE=fixture
# Gmail 검색 쿼리. Gmail 검색창에 넣는 문법 그대로 쓴다
MAIL_QUERY=is:unread subject:(테스트 요청)
MAIL_MAX_RESULTS=10
MAIL_FIXTURE_DIR=fixtures/mails

# === 구글 OAuth (MAIL_SOURCE=gmail 일 때 필수) ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# node scripts/google-auth.js 로 발급
GOOGLE_REFRESH_TOKEN=

# === 지라 ===
# cloud | server | none
JIRA_TYPE=none
JIRA_BASE_URL=
# cloud일 때만 필수. server는 PAT만 쓰면 비워 둔다
JIRA_EMAIL=
JIRA_API_TOKEN=

# === 채널 자동 게시 ===
# false면 커맨드로 조회할 때만 메일을 읽는다. true로 켜면 SLACK_NOTIFY_CHANNEL 이 필수다
POLL_ENABLED=false
POLL_INTERVAL_SECONDS=60

# === 처리 기록 ===
SEEN_STORE_PATH=data/seen-mails.json
SEEN_STORE_MAX_ENTRIES=500
